// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows collapsed 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style=""
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <button
        aria-label="Open sidebar"
        class="iconButton toggle"
        data-sidebar-toggle="true"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="d95b7908"
          data-icon="dsw-icon-panel-left-outline-regular"
          height="16"
          width="16"
        />
        <div
          data-slot="sidebar.toggle.badge"
          style="display: contents;"
        />
      </button>
    </div>
    <div
      class="newSessionRow"
    >
      <div
        data-slot="sidebar.session.action"
        style="display: contents;"
      >
        <button
          aria-label="New session"
          class="newSession"
          type="button"
        >
          <span
            class="newSessionLabelMask"
          >
            <span
              class="newSessionContent"
            >
              <svg
                aria-hidden="true"
                data-content="6e5e38f3"
                data-icon="dsw-icon-new-chat-outline-regular"
                height="16"
                width="16"
              />
            </span>
          </span>
        </button>
      </div>
    </div>
    <div
      class="scrollRegion"
    >
      <div
        class="scrollArea"
      >
        <div
          class="regionArea"
        >
          <div
            data-slot="sidebar.workspaces"
            style="display: contents;"
          />
        </div>
      </div>
      <span
        aria-hidden="true"
        class="scrollFade"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="settingsArea"
      >
        <div
          data-slot="sidebar.settings"
          style="display: contents;"
        />
      </div>
      <span
        class="root panelMoreSlot panelMoreRail"
      >
        <button
          aria-expanded="false"
          aria-haspopup="menu"
          aria-label="More"
          class="iconButton panelMore"
          type="button"
        >
          <svg
            aria-hidden="true"
            data-content="ce3185ff"
            data-icon="dsw-icon-ellipsis-outline-regular"
            height="16"
            width="16"
          />
        </button>
      </span>
    </div>
  </div>
</div>
`;

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows expanded 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root quietBars"
    style="width: 300px;"
  >
    <div
      class="logoRow"
      data-window-drag="true"
    >
      <span
        class="usageGlance"
      >
        <span
          aria-label="Usage statistics"
          class="glanceReadout"
          role="group"
          title="Usage statistics"
        >
          <span
            class="glanceBody"
          >
            <span
              class="glanceRows"
            />
            <span
              class="glanceStats"
              title="Tokens today · Tokens this plan cycle · API —"
            >
              <span
                class="glanceStat"
              >
                <span
                  class="glanceStatLabel"
                >
                  Today
                </span>
                <span
                  class="glanceStatValue"
                >
                  —
                </span>
              </span>
              <span
                class="glanceStat"
              >
                <span
                  class="glanceStatLabel"
                >
                  Cycle
                </span>
                <span
                  class="glanceStatValue"
                >
                  —
                </span>
              </span>
              <span
                class="glanceStat"
              >
                <span
                  class="glanceStatLabel"
                >
                  API
                </span>
                <span
                  class="glanceStatValue"
                >
                  —
                </span>
              </span>
            </span>
          </span>
        </span>
      </span>
      <span
        aria-hidden="true"
        class="brandName"
      >
        <div
          data-slot="sidebar.brand.name"
          style="display: contents;"
        />
      </span>
      <button
        aria-label="Collapse sidebar"
        class="iconButton toggle"
        data-sidebar-toggle="true"
        type="button"
      >
        <svg
          aria-hidden="true"
          class="panelIcon"
          data-content="d95b7908"
          data-icon="dsw-icon-panel-left-outline-regular"
          height="16"
          width="16"
        />
      </button>
    </div>
    <div
      class="newSessionRow"
    >
      <div
        data-slot="sidebar.session.action"
        style="display: contents;"
      >
        <button
          aria-label="New session"
          class="newSession"
          type="button"
        >
          <span
            class="newSessionLabelMask"
          >
            <span
              class="newSessionContent"
            >
              <svg
                aria-hidden="true"
                data-content="532cf99a"
                data-icon="dsw-icon-new-chat-outline-medium"
                height="14"
                width="14"
              />
              <span
                class="newSessionLabel wide"
              >
                New Session
              </span>
            </span>
          </span>
        </button>
      </div>
    </div>
    <div
      class="scrollRegion"
    >
      <div
        class="scrollArea"
        data-sidebar-scrollport=""
      >
        <div
          class="regionArea"
        >
          <div
            data-slot="sidebar.workspaces"
            style="display: contents;"
          />
        </div>
      </div>
      <span
        aria-hidden="true"
        class="scrollFade"
      />
    </div>
    <div
      class="footArea"
    >
      <div
        class="footRow"
      >
        <div
          class="settingsArea"
        >
          <div
            data-slot="sidebar.settings"
            style="display: contents;"
          />
        </div>
        <span
          class="root panelMoreSlot"
        >
          <button
            aria-expanded="false"
            aria-haspopup="menu"
            aria-label="More"
            class="iconButton panelMore"
            type="button"
          >
            <svg
              aria-hidden="true"
              data-content="ce3185ff"
              data-icon="dsw-icon-ellipsis-outline-regular"
              height="16"
              width="16"
            />
          </button>
        </span>
      </div>
    </div>
  </div>
</div>
`;

